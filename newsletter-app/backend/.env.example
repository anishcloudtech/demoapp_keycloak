PORT=4002
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=CloudTech
BLOG_BACKEND_URL=http://localhost:4001

# ── Keycloak Admin API (required for login/logout/admin audit events) ─────────
# Steps to enable:
#  1. In Keycloak Admin Console: create a confidential client (or reuse an
#     existing one) and enable "Service accounts enabled".
#  2. Go to the client's "Service account roles" tab and assign the
#     "view-events" role from the "realm-management" client.
#  3. In Realm Settings → Events → turn ON "Save Events" (user events)
#     and optionally "Save admin events".
#  4. Paste the client-id and client-secret below.
KEYCLOAK_ADMIN_CLIENT_ID=newsletter-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=your-client-secret-here
